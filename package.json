{
	"name": "keyed",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "bun run check:format && bun run check-types",
		"check:format": "biome check --write .",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "turbo -F native dev",
		"test": "turbo run test",
		"test:native": "turbo run test --filter=@keyed/engine --force",
		"test:native:build": "cd packages/engine/tests && cmake -B build && cmake --build build",
		"test:native:run": "cd packages/engine/tests && ./build/engine_tests",
		"test:native:golden": "python scripts/generate-golden-files.py"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"onnxruntime-node": "^1.23.2",
		"turbo": "^2.5.4"
	},
	"packageManager": "bun@1.2.16"
}
